# Runtime
TRADEFLOW_MODE=live
DATABASE_URL=sqlite:///./data/tradeflow.db
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
TRADEFLOW_DETERMINISTIC_FINAL_ANSWER=true
TRADEFLOW_LIVE_REPLANNING_MODEL=false
TRADEFLOW_LIVE_SUPERVISOR_ROUTING_MODEL=true
TRADEFLOW_LANGGRAPH_TIMEOUT_SECONDS=600
TRADEFLOW_UI_REQUEST_TIMEOUT_SECONDS=600
TRADEFLOW_LANGGRAPH_URL=http://127.0.0.1:2024
TRADEFLOW_LANGGRAPH_GRAPH_ID=chat

# OpenAI - set the secret only in .env
OPENAI_API_KEY=
TRADEFLOW_MODEL_PLANNING=gpt-5.6-sol
TRADEFLOW_MODEL_SUPERVISOR=gpt-5.6-sol
TRADEFLOW_MODEL_DOCUMENT=gpt-5.6-terra
TRADEFLOW_MODEL_SHIPMENT=gpt-5.6-terra
TRADEFLOW_MODEL_FINANCIAL=gpt-5.6-terra
TRADEFLOW_MODEL_PRODUCT=gpt-5.6-terra
TRADEFLOW_MODEL_REPORT_WRITER=gpt-5.6-terra
TRADEFLOW_MODEL_CRITIC=gpt-5.6-sol
TRADEFLOW_REASONING_SUPERVISOR=medium
TRADEFLOW_REASONING_SPECIALIST=medium
TRADEFLOW_REASONING_CRITIC=medium

# LangSmith - set the secret only in .env
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kb-tradeflow-twin-live
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
