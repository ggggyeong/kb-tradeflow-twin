# Low-cost live practice profile.
#
# This file contains no secrets. OPENAI_API_KEY and LANGSMITH_API_KEY remain in
# the project-root .env. Environment variables loaded here override only model
# routing and reasoning for the practice process.
TRADEFLOW_MODE=live
LANGSMITH_PROJECT=kb-tradeflow-twin-practice
TRADEFLOW_DETERMINISTIC_FINAL_ANSWER=true
TRADEFLOW_LIVE_REPLANNING_MODEL=false
TRADEFLOW_LIVE_SUPERVISOR_ROUTING_MODEL=false
TRADEFLOW_LANGGRAPH_URL=http://127.0.0.1:2024
TRADEFLOW_LANGGRAPH_GRAPH_ID=chat

# Quality-critical control and review roles.
TRADEFLOW_MODEL_PLANNING=gpt-5.6-terra
TRADEFLOW_MODEL_SUPERVISOR=gpt-5.6-terra
TRADEFLOW_MODEL_FINANCIAL=gpt-5.6-terra
TRADEFLOW_MODEL_CRITIC=gpt-5.6-terra

# High-frequency specialist roles. Calculations and DB writes remain Tool-owned.
TRADEFLOW_MODEL_DOCUMENT=gpt-5.6-luna
TRADEFLOW_MODEL_SHIPMENT=gpt-5.6-luna
TRADEFLOW_MODEL_PRODUCT=gpt-5.6-luna
TRADEFLOW_MODEL_REPORT_WRITER=gpt-5.6-luna

TRADEFLOW_REASONING_SUPERVISOR=low
TRADEFLOW_REASONING_SPECIALIST=low
TRADEFLOW_REASONING_CRITIC=low
